# ============================================================================
# CONFIGURACIÓN DEL SISTEMA RAG - CLUB ATLÉTICO PUERTO MARINA
# ============================================================================

# Modo de síntesis:
# Si LLM_API_KEY está vacío (y USE_EXTERNAL_LLM=false), el sistema usa el
# Motor Extractivo Local de Alta Precisión (0 costo, 0 dependencias externas).
USE_EXTERNAL_LLM=false

# --- OPCIÓN A: Ollama Local (cuando quieras conectar un LLM local gratis) ---
# USE_EXTERNAL_LLM=true
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# --- OPCIÓN B: Groq Cloud (ultra rápido) ---
# USE_EXTERNAL_LLM=true
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_tu_api_key_aqui
# LLM_MODEL=llama-3.3-70b-versatile

# --- OPCIÓN C: Google Gemini (vía endpoint compatible con OpenAI) ---
# USE_EXTERNAL_LLM=true
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaSy_tu_api_key_aqui
# LLM_MODEL=gemini-2.5-flash

# --- OPCIÓN D: OpenAI Oficial ---
# USE_EXTERNAL_LLM=true
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-tu_api_key_aqui
# LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SEC=20
